# ── Resend email integration ──────────────────────────────────────
# 1. Create a free account at https://resend.com
# 2. Add & verify your sending domain (or use the test address below)
# 3. Create an API key and paste it here.

# Your Resend API key (required to actually send booking emails)
RESEND_API_KEY=

# The address bookings are sent TO (the notary's inbox)
NOTARY_EMAIL=toyganbaeva760@gmail.com

# The verified "from" address. While testing you can use Resend's sandbox:
#   Notary Website <onboarding@resend.dev>
# In production use your verified domain, e.g.:
#   Notary <noreply@your-domain.kz>
RESEND_FROM_EMAIL=Notary Website <onboarding@resend.dev>
